# ===== LumenX @ 192.168.8.231 部署环境变量 =====
# 拷贝为 .env 后，手动填入你的 DeepSeek key 等敏感信息
# cp .env.231 .env && vim .env

# ---- LLM: DeepSeek (OpenAI 兼容接口) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ---- 存储策略: 纯本地, 不走 OSS ----
# OSS_ENABLE=false 会跳过云存储上传，生成的图片/视频全部保存在本地 output/ 目录
OSS_ENABLE=false
# 以下 OSS 变量留空即可，确保不启用云存储
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_BASE_PATH=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# ---- API 服务 ----
API_HOST=0.0.0.0
API_PORT=17177

# ---- DashScope (前端启动检查必需，填假值跳过；真功能需真实 key) ----
# 前端 EnvConfigChecker 强制要求 DASHSCOPE_API_KEY 非空才能进入界面
# 填假值可绕过检查先看界面，但图像/配音/VL 等功能会因无真实 key 而失败
# 通义万相(Wanx)图像生成、CosyVoice/TTS 配音、Qwen-VL 多模态都走 DashScope
# 开发调试时用假值，正式使用时替换为真实 key
DASHSCOPE_API_KEY=

# ---- 可选视频 provider, 按需启用 ----
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# VIDU_API_KEY=
# MULEROUTER_API_KEY=
# MULEROUTER_SITE=mulerouter
